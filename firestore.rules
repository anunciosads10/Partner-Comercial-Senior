rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function getUserRole() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role; }
    function isSuperAdmin() { return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserRole() == 'superadmin'; }
    function isAdmin() { return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (getUserRole() == 'admin' || getUserRole() == 'superadmin'); }

    match /users/{userId} {
      allow get, list: if true;
      allow create: if isOwner(userId);
      allow update, delete: if isSuperAdmin();
    }

    match /partners/{partnerId} {
      allow get, list: if true;
      allow create: if true;
      allow update: if isOwner(partnerId) || isSuperAdmin() || 
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clicks']) ||
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['signupsFromLink']) ||
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['referralCode']) ||
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['platformMetrics']) ||
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clicks', 'signupsFromLink']) ||
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clicks', 'signupsFromLink', 'platformMetrics']) ||
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clicks', 'signupsFromLink', 'referralCode', 'platformMetrics']);
      allow delete: if isSuperAdmin();

      match /notifications/{notificationId} {
        allow read: if isOwner(partnerId) || isSuperAdmin();
        allow create: if true;
        allow update, delete: if isOwner(partnerId) || isSuperAdmin();
      }

      match /{allSubcollections=**} {
        allow read: if isOwner(partnerId) || isSuperAdmin();
        allow write: if isOwner(partnerId) || isSuperAdmin();
      }
    }

    match /referrals/{referralId} {
      allow read, list: if isSignedIn() && (resource.data.partnerId == request.auth.uid || isSuperAdmin());
      allow create: if isSuperAdmin() || 
                       (isSignedIn() && request.resource.data.partnerId == request.auth.uid && (request.resource.data.status == 'registrado' || request.resource.data.status == 'pendiente_activacion') && !('activatedAt' in request.resource.data) && !('recurringEndsAt' in request.resource.data)) ||
                       (request.resource.data.externalUserId != null);
      allow update: if isSignedIn() && (
        isSuperAdmin() || (
          resource.data.partnerId == request.auth.uid &&
          request.resource.data.partnerId == request.auth.uid &&
          request.resource.data.status != 'activo' &&
          (!('activatedAt' in request.resource.data) || request.resource.data.activatedAt == resource.data.activatedAt) &&
          (!('recurringEndsAt' in request.resource.data) || request.resource.data.recurringEndsAt == resource.data.recurringEndsAt)
        )
      );
      allow delete: if isSuperAdmin();
    }

    match /transactions/{transactionId} {
      allow read, list: if isSignedIn() && (resource.data.partnerId == request.auth.uid || isSuperAdmin());
      allow create: if isSuperAdmin() || (request.resource.data.type in ['activacion', 'recurrente'] && request.resource.data.status in ['aprobado', 'pendiente']);
      allow update, delete: if isSuperAdmin();
    }

    match /activations/{activationId} {
      allow read, list: if isSignedIn() && (resource.data.partnerId == request.auth.uid || isSuperAdmin());
      allow create: if isSignedIn() && (
        isSuperAdmin() || (
          request.resource.data.partnerId == request.auth.uid &&
          request.resource.data.status == 'enviado'
        )
      );
      allow update, delete: if isSuperAdmin();
    }

    match /payments/{paymentId} {
      allow read: if isSignedIn() && (resource.data.partnerId == request.auth.uid || isSuperAdmin());
      allow write: if isSuperAdmin();
      allow create: if isSignedIn() && request.resource.data.partnerId == request.auth.uid;
    }

    match /commissions/{id} { allow read, write: if isSuperAdmin(); }
    match /commission_schemes/{id} { allow read: if isSignedIn(); allow write: if isSuperAdmin(); }
    match /rules/{id} { allow read: if isSignedIn(); allow write: if isSuperAdmin(); }
    // Catalogo de plataformas SaaS: lectura publica para que el endpoint consulte los planes oficiales
    match /saasPlatforms/{id} { allow read, list: if true; allow write: if isSuperAdmin(); }
    // Colección Recursos de Marketing
    match /marketingAssets/{assetId} {
      allow read, list: if isSignedIn();
      allow write, create, update, delete: if isSuperAdmin();
    }

    // Configuración de Opciones de Marketing (Tipos y Canales dinámicos)
    match /marketingSettings/{docId} {
      allow read, get: if isSignedIn();
      allow write, create, update, delete: if isSuperAdmin();
    }

    match /settings/{id} { allow read, write: if isSuperAdmin(); }
  }
}
