rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Funciones de Ayuda (Optimizadas para evitar exceder límites de lectura)
    // -------------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Obtiene el rol de forma segura
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isSuperAdmin() {
      return isSignedIn() && getUserRole() == 'superadmin';
    }

    function isAdmin() {
      let role = getUserRole();
      return isSignedIn() && (role == 'admin' || role == 'superadmin');
    }
    
    // -------------------------------------------------------------------------
    // Reglas para la colección de Usuarios
    // -------------------------------------------------------------------------
    
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update, delete: if isSuperAdmin();
      allow list: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // Reglas para Partners y sus Subcolecciones
    // -------------------------------------------------------------------------

    match /partners/{partnerId} {
      allow get: if isOwner(partnerId) || isAdmin();
      allow list: if isAdmin();
      allow create, update, delete: if isOwner(partnerId) || isSuperAdmin();

      match /{allSubcollections=**} {
        allow read: if isOwner(partnerId) || isAdmin();
        allow write: if isOwner(partnerId) || isSuperAdmin();
      }
    }
    
    // -------------------------------------------------------------------------
    // Colección Global de Pagos (Optimizada para consultas estáticas de filtros)
    // -------------------------------------------------------------------------
    match /payments/{paymentId} {
      allow read: if isSignedIn() && (resource.data.partnerId == request.auth.uid || isSuperAdmin());
      allow write: if isSuperAdmin();
      allow create: if isSignedIn() && request.resource.data.partnerId == request.auth.uid;
    }
    
    // -------------------------------------------------------------------------
    // Otras Colecciones Globales
    // -------------------------------------------------------------------------
    match /commissions/{commissionId} {
      allow read, write: if isSuperAdmin();
    }

    match /commission_schemes/{schemeId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    match /rules/{ruleId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }
    
    match /saasPlatforms/{saasPlatformId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }
    
    match /settings/{settingId} {
      allow read: if isAdmin();
      allow write: if isSuperAdmin();
    }
  }
}